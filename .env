# Server configuration
SERVER_HOST=0.0.0.0 
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# gRPC configuration
# GRPC_HOST=0.0.0.0
# GRPC_PORT=9090

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=users
DB_USER=postgres
DB_PASSWORD=137980
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Goose migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=host=localhost port=5432 user=postgres password=137980 dbname=users sslmode=disable

# Authentication configuration
AUTH_KEYCLOAK_URL=http://localhost:8080
AUTH_KEYCLOAK_REALM=master
AUTH_KEYCLOAK_CLIENT_ID=users
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/master

# MINIO configuration
MINIO_ENDPOINT=localhost:9000
MINIO_CLIENT_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=admin
MINIO_SECRET_ACCESS_KEY=12345678
MINIO_SSL_MODE=false
MINIO_REGION=us-east-1
